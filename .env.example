# Optional overrides for local deployment
# Frontend is served by nginx on port 80
# Backend API is exposed on port 5000

# Flask secret (required in production)
FLASK_SECRET_KEY=change-me

# Persistent SQLite path inside container
SQLALCHEMY_DATABASE_URI=sqlite:////data/campus_assistant.db

# Docker published ports on host
FRONTEND_PORT=80
BACKEND_PORT=5000
